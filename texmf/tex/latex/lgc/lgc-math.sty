\def\Zc{\mathcal{Z}}

%------------------------------------------------------------------------------%

% ENVIRONMENTS

\newtheoremstyle{lgcplain}
  {0.5\baselineskip}    % Space above
  {0.5\baselineskip}    % Space below
  {\itshape}            % Body font
  {}                    % Indent amount
  {\scshape}            % Theorem head font
  {.}                   % Punctuation after theorem head
  {0.5em}               % Space after theorem head
  {}                    % Theorem head spec

\newtheoremstyle{lgcdefinition}
  {0.5\baselineskip}    % Space above
  {0.5\baselineskip}    % Space below
  {\normalfont}         % Body font
  {}                    % Indent amount
  {\bfseries}           % Theorem head font
  {.}                   % Punctuation after theorem head
  {0.5em}               % Space after theorem head
  {}                    % Theorem head spec

\theoremstyle{lgcplain}
\@ifundefined{theorem}{\newtheorem{theorem}{Theorem}}{}
\@ifundefined{prop}{\newtheorem{prop}{Proposition}}{}
\@ifundefined{prop*}{\newtheorem*{prop*}{Proposition}}{}
\@ifundefined{corollary}{\newtheorem{corollary}{Corollary}}{}
\@ifundefined{lemma}{\newtheorem{lemma}{Lemma}}{}

\theoremstyle{lgcdefinition}
\@ifundefined{definition}{\newtheorem{definition}{Definition}}{}
\@ifundefined{assumption}{\newtheorem{assumption}{Assumption}}{}
\@ifundefined{example}{\newtheorem{example}{Example}}{}
\@ifundefined{remark}{\newtheorem{remark}{Remark}}{}

% Explicit names for hyperref's \autoref command.
\providecommand{\theoremautorefname}{Theorem}
\providecommand{\propautorefname}{Proposition}
\providecommand{\corollaryautorefname}{Corollary}
\providecommand{\lemmaautorefname}{Lemma}
\providecommand{\definitionautorefname}{Definition}
\providecommand{\assumptionautorefname}{Assumption}
\providecommand{\exampleautorefname}{Example}
\providecommand{\remarkautorefname}{Remark}
