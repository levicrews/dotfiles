{
    // Basic
    "workbench.colorTheme": "Atom One Dark",
    "workbench.iconTheme": "vscode-icons",
    "workbench.startupEditor": "none",
    "workbench.settings.editor": "json",
    "workbench.settings.useSplitJSON": true,
    "workbench.settings.openDefaultSettings": false,
    "window.restoreWindows": "none",
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "hidden",
    "vsicons.dontShowNewVersionMessage": true,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "file:/**/*.csv": "jupyter-data-wrangler"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editor.tabActionCloseVisibility": false,

    // Editor
    "editor.rulers": [80],
    "editor.fontFamily": "'Cascadia Code PL', 'monospace', monospace",
    "editor.fontLigatures": false,
    "editor.tabSize": 4,
    "editor.tabCompletion": "onlySnippets",
    "editor.snippetSuggestions": "top",
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.formatOnPaste": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.inlineSuggest.enabled": true,
    "editor.renderWhitespace": "all",

    // Diff Editor
    "diffEditor.ignoreTrimWhitespace": true,

    // Terminal
    "terminal.integrated.fontFamily": "'Cascadia Code PL'",
    "terminal.integrated.commandsToSkipShell": [
        "language-julia.interrupt",
        "matlab.interrupt"
    ],

    // Files
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,

    // LaTeX
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.clean.method": "glob",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.brf",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.fls",
        "*.log",
        "*.fdb_latexmk",
        "*.snm",
        "*.synctex(busy)",
        "*.synctex.gz",
        "*.nav",
        "*.vrb"
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk 🔃",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "latexmk (for EPS)",
            "tools": [
                "latexmk -xelatex -shell-escape document"
            ]
        },
        {
            "name": "latexmk (latexmkrc)",
            "tools": [
                "latexmk_rconly"
            ]
        },
        {
            "name": "latexmk (lualatex)",
            "tools": [
                "lualatexmk"
            ]
        },
        {
            "name": "pdflatex ➞ bibtex ➞ pdflatex × 2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "Compile Rnw files",
            "tools": [
                "rnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Jnw files",
            "tools": [
                "jnw2tex",
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "lastUsed",
    "latex-utilities.message.update.show": false,

    // Python
    "python.languageServer": "Pylance",
    "python.defaultInterpreterPath": "/bin/python3",
    "[python]": {
        "editor.suggestSelection": "first",
        "editor.formatOnType": true
    },

    // Matlab
    "matlab.mlintpath": "/usr/local/MATLAB/R2025b/bin/glnxa64/mlint",
    "MATLAB.showFeatureNotAvailableError": false,

    // Julia
    "julia.execution.resultType": "inline",
    "julia.symbolCacheDownload": true,
    "julia.enableTelemetry": false,

    // R
    "r.lsp.diagnostics": false,

    // Markdown
    "markdown-pdf.displayHeaderFooter": true,
    "markdown-pdf.headerTemplate": "<div style=\"font-size: 9px; margin-left: auto; margin-right: 1cm; \"> <span class='date'></span></div>",
    "markdown-pdf.footerTemplate": "<div style=\"font-size: 9px; margin: 0 auto;\"> <span class='pageNumber'></span> / <span class='totalPages'></span></div>",
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },

    // Project Manager
    "projectManager.git.baseFolders": [
        "$home/Documents"
    ],

    // Jupyter
    "jupyter.askForKernelRestart": false,
    "jupyter.interactiveWindow.creationMode": "perFile",

    // Git and GitHub
    "git.confirmSync": false,
    "git.ignoreLegacyWarning": true,
    "git.openRepositoryInParentFolders": "always",
    "githubPullRequests.pullBranch": "never",
    "gitlens.launchpad.indicator.enabled": false,
    "githubPullRequests.createOnPublishBranch": "never",

    // Copilot and Chat
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "yaml": false,
        "txt": true
    },
    "github.copilot.nextEditSuggestions.fixes": false,
    "chat.viewSessions.orientation": "stacked",
    "chat.mcp.gallery.enabled": true,

    // YAML
    "redhat.telemetry.enabled": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    // Makefile
    "makefile.configureOnOpen": true,
}
