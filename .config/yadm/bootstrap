#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

echo "[sudo] acquiring credentials..."
sudo -v

# Prereqs + repos (once)
sudo apt-get update -y
sudo apt-get install -y software-properties-common curl wget gpg
sudo add-apt-repository -y ppa:kelleyk/emacs
sudo add-apt-repository -y ppa:inkscape.dev/stable

# Microsoft repo for VS Code (only add if missing)
if [ ! -f /etc/apt/sources.list.d/vscode.list ]; then
  echo "Adding Microsoft apt repo for VS Code..."
  wget -qO- https://packages.microsoft.com/keys/microsoft.asc \
    | sudo gpg --dearmor -o /usr/share/keyrings/packages.microsoft.gpg
  echo "deb [arch=amd64 signed-by=/usr/share/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
    | sudo tee /etc/apt/sources.list.d/vscode.list > /dev/null
fi
sudo apt-get update -y

# Rust (non-interactive)
if ! command -v cargo >/dev/null 2>&1; then
  curl -fsSL https://sh.rustup.rs | sh -s -- -y
fi
export PATH="$HOME/.cargo/bin:$PATH"

# Read non-empty, non-comment lines
lines() { grep -vE '^\s*(#|$)' "$1" || true; }

shopt -s nullglob
for f in *.list; do
  tool="${f%.*}"   # e.g. apt.list -> apt
  echo "==> Installing $tool packages..."

  # Auto-install the tool if the list requires it
  if [[ "$tool" == "code" ]] && ! command -v code >/dev/null 2>&1; then
    sudo apt-get install -y code
  elif [[ "$tool" == "npm" ]] && ! command -v npm >/dev/null 2>&1; then
    sudo apt-get install -y nodejs npm
  elif [[ "$tool" =~ ^(pip|pip3)$ ]] && ! command -v pip3 >/dev/null 2>&1; then
    sudo apt-get install -y python3 python3-pip
  fi

  while IFS= read -r pkg; do
    case "$tool" in
      apt|apt-get) sudo apt-get install -y $pkg ;;
      snap)        sudo snap install $pkg ;;
      npm)         sudo npm install -g $pkg ;;
      pip|pip3)    python3 -m pip install --user $pkg ;;
      cargo)       cargo install $pkg ;;
      code)        code --install-extension "$pkg" ;;
      *)           : ;;  # unknown tool: silently skip
    esac
  done < <(lines "$f")

  echo "<== Finished installing $tool packages."
done

# Optional: only if present
[[ -e /usr/local/bin/pdfsearch ]] && sudo chmod +x /usr/local/bin/pdfsearch

echo "Bootstrap complete."