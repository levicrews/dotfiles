#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

echo "[sudo] acquiring credentials..."
sudo -v

# --- One-time repo setup (idempotent) --- #
sudo apt-get update -y
sudo apt-get install -y software-properties-common curl wget gpg
sudo add-apt-repository -y ppa:inkscape.dev/stable || true
# Microsoft VS Code apt repo (minimal + idempotent)
if ! grep -qr 'https://packages.microsoft.com/repos/code' /etc/apt/sources.list* /etc/apt/sources.list.d 2>/dev/null; then
    sudo install -d -m 755 /usr/share/keyrings
    wget -qO- https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor --yes -o /usr/share/keyrings/packages.microsoft.gpg
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
        | sudo tee /etc/apt/sources.list.d/vscode.list >/dev/null
    sudo apt-get update -y
fi
sudo apt-get update -y

# --- Rust only if needed (cargo.list present) --- #
if [[ -f cargo.list ]] && ! command -v cargo >/dev/null 2>&1; then
    echo "Installing Rust toolchain (rustup) because cargo.list is present..."
    curl -fsSL https://sh.rustup.rs | sh -s -- -y
fi
export PATH="$HOME/.cargo/bin:$PATH"

# --- Helpers --- #
lines() { grep -vE '^\s*(#|$)' "$1" || true; }	# skip comments/blank lines

apt_installed()   { dpkg-query -W -f='${Status}\n' "$1" 2>/dev/null | grep -q "install ok installed"; }
snap_installed()  { snap list "$1" >/dev/null 2>&1; }
npm_installed()   { npm list -g --depth=0 "$1" >/dev/null 2>&1; }
cargo_installed() { cargo install --list 2>/dev/null | awk '{print $1}' | grep -xq "$1"; }

# VS Code extension helpers: normalize ID and check installed
code_id() { printf '%s' "$1" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g;s/[[:space:]]+//g' | awk -F'@' '{print tolower($1)}'; }
code_installed() {
    local id; id="$(code_id "$1")"
    code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]' | grep -xq "$id"
}

ensure_tool() {
    case "$1" in
        code)
            command -v code >/dev/null 2>&1 || sudo apt-get install -y code
            ;;
        npm)
            command -v npm  >/dev/null 2>&1 || sudo apt-get install -y nodejs npm
            ;;
        uvtool|uv)
            # We use uv for Python CLIs; make sure prerequisites are there.
            command -v python3 >/dev/null 2>&1 || sudo apt-get install -y python3 python3-venv
            command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh
            ;;
    esac
}

install_pkg() {
    local tool="$1" line="$2"
    local name="${line%% *}"	# first token (handles flags like "--classic")

    case "$tool" in
        apt|apt-get)
            apt_installed "$name" || sudo apt-get install -y $line
            ;;
        snap)
            snap_installed "$name" || sudo snap install $line
            ;;
        npm)
            npm_installed "$name" || sudo npm install -g $line
            ;;
        uvtool|uv)
            # uv is idempotent; re-running is safe & quiet if already installed.
			uv tool install "$line" || echo "(warn) uv failed to install: $line"
			;;
        cargo)
            cargo_installed "$name" || cargo install $line
            ;;
        code)
            # Idempotent: skip if already installed (tolerates @version / whitespace)
            if ! code_installed "$line"; then
                # Try exactly as listed first (allows @version), then fall back to bare ID
                code --install-extension "$line" \
                || code --install-extension "$(code_id "$line")" \
                || echo "	(warn) failed to install VS Code extension: $line"
            fi
            ;;
        *)
            : ;;  # unknown tool: skip
    esac
}

# --- Main loop --- #
shopt -s nullglob
for f in *.list; do
    case "$(basename -- "$f")" in
        gogh.list|pylib.list) continue ;;
    esac

    tool="${f%.*}"	# e.g., apt.list -> apt
    echo "==> Installing $tool packages..."
    ensure_tool "$tool"

    while IFS= read -r pkg; do
        # trim whitespace; skip empty after trimming
        pkg="$(printf '%s' "$pkg" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
        [[ -z "$pkg" ]] && continue
        install_pkg "$tool" "$pkg"
    done < <(lines "$f")

    echo "<== Finished installing $tool packages."
done

# --- Install from source --- #
echo "==> Installing packages from source..."

# 1) Starship prompt (install only if missing)
if ! command -v starship >/dev/null 2>&1; then
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# 2) Gogh GNOME Terminal themes driven by gogh.list (install only if missing)
if command -v gnome-terminal >/dev/null 2>&1 && command -v gsettings >/dev/null 2>&1; then
    export TERMINAL=gnome-terminal

    # does a GNOME Terminal profile with visible-name == $1 exist?
    gnome_profile_exists() {
        local want="$1"
        local uuids
        uuids="$(gsettings get org.gnome.Terminal.ProfilesList list 2>/dev/null | tr -d "[],'")" || return 1
        for uuid in $uuids; do
            local vis
            vis="$(gsettings get "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:${uuid}/" visible-name 2>/dev/null || true)"
            vis="${vis//\'}"
            if [[ "$vis" == "$want" ]]; then return 0; fi
        done
        return 1
    }

    # ensure repo present/updated
    if [[ -d "$HOME/util/gogh/.git" ]]; then
        git -C "$HOME/util/gogh" fetch --all -p >/dev/null 2>&1 || true
        git -C "$HOME/util/gogh" pull --ff-only >/dev/null 2>&1 || true
    else
        git clone https://github.com/levicrews/Gogh.git "$HOME/util/gogh" # use my fork with extra themes
    fi

    # permanently normalize default profile name (Gogh expects "Default")
    default_uuid="$(gsettings get org.gnome.Terminal.ProfilesList default | tr -d "'")"
    curr_name="$(gsettings get "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:${default_uuid}/" visible-name | tr -d "'")"
    if [[ "$curr_name" != "Default" ]]; then
        gsettings set "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:${default_uuid}/" visible-name "Default"
    fi

    # read themes from gogh.list (one per line, .sh optional); else default to "atom dracula"
    if [[ -f gogh.list ]]; then
        themes="$(grep -vE '^\s*(#|$)' gogh.list | tr '\n' ' ')"
    fi

    pushd "$HOME/util/gogh/installs" >/dev/null
    for script in $themes; do
        slug="${script%.sh}"
        theme_name="${slug^}"	# "atom" -> "Atom"
        if ! gnome_profile_exists "$theme_name"; then
            "./${slug}.sh" || true	# don't abort entire bootstrap if a single theme fails
        fi
    done
    popd >/dev/null
fi

# 3) Sparklines in terminal (install only if missing)
if ! command -v spark >/dev/null 2>&1; then
    sudo sh -c "curl https://raw.githubusercontent.com/holman/spark/master/spark -o /usr/local/bin/spark && chmod +x /usr/local/bin/spark"
fi

# 4) cheat.sh client
if ! command -v cht.sh >/dev/null 2>&1; then
    curl -s https://cht.sh/:cht.sh | sudo tee /usr/local/bin/cht.sh && sudo chmod +x /usr/local/bin/cht.sh
fi

echo "<== Finished installing packages from source."

# --- Install fonts --- #
echo "==> Installing fonts..."

# 1) Cascadia Code (prefer apt; skip if installed)
if ! fc-list | grep -qi 'Cascadia Code'; then
    if ! sudo apt-get install -y fonts-cascadia-code; then
        tmp="$(mktemp -d)"
        if curl -fsSL -o "$tmp/cc.zip" "https://github.com/microsoft/cascadia-code/releases/latest/download/CascadiaCode-ttf.zip"; then
            mkdir -p "$HOME/.local/share/fonts/CascadiaCode"
            unzip -o "$tmp/cc.zip" -d "$tmp/cc" >/dev/null
            find "$tmp/cc" -type f -name "*.ttf" -exec cp -f {} "$HOME/.local/share/fonts/CascadiaCode/" \;
            fc-cache -f >/dev/null
        else
            echo "	(warn) could not fetch Cascadia Code from GitHub; skipping"
        fi
        rm -rf "$tmp"
    fi
fi

# 2) Monaspace (clone repo once; copy fonts if missing)
if ! fc-list | grep -qi 'Monaspace'; then
    mkdir -p "$HOME/.local/share/fonts/Monaspace"
    if [[ -d "$HOME/util/monaspace/.git" ]]; then
        git -C "$HOME/util/monaspace" pull --ff-only >/dev/null 2>&1 || true
    else
        git clone https://github.com/githubnext/monaspace "$HOME/util/monaspace"
    fi
    find "$HOME/util/monaspace" -type f \( -name "*.otf" -o -name "*.ttf" \) -exec cp -u {} "$HOME/.local/share/fonts/Monaspace/" \;
    fc-cache -f >/dev/null
fi

echo "<== Finished installing fonts."

# --- Runtimes (Julia via juliaup) --- #
echo "==> Installing runtimes..."
if ! command -v juliaup >/dev/null 2>&1; then
    curl -fsSL https://install.julialang.org | sh -s -- -y
fi
echo "<== Finished installing runtimes."

# --- Remap Caps Lock to Ctrl --- #
echo "==> Remapping keys..."
gsettings set org.gnome.desktop.input-sources xkb-options "['caps:ctrl_modifier']"
echo "<== Finished remapping keys."

# --- Initialize Git (globals, LFS, Delta diffs) --- #
echo "==> Initializing Git..."
git config --global fetch.prune true
git config --global status.short true   # like: git status -s
git config --global status.branch true  # add branch/upstream line (like -b)

if command -v git-lfs >/dev/null 2>&1; then
    git lfs install --skip-repo >/dev/null 2>&1 || git lfs install >/dev/null 2>&1
fi

# Set delta as Git pager only if delta exists AND no pager is configured yet
if command -v delta >/dev/null 2>&1 && ! git config --global --get core.pager >/dev/null 2>&1; then
    git config --global core.pager delta
    git config --global delta.side-by-side true
    git config --global interactive.diffFilter 'delta --color-only'
    git config --global delta.navigate true # use n and N to move between diff sections
    git config --global merge.conflictStyle zdiff3
fi
echo "<== Finished initializing Git."

# --- END --- #
echo "Bootstrap complete."
