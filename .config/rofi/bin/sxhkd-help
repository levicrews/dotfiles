#!/bin/bash

configs=("$HOME/.config/sxhkd/sxhkdrc")
[[ ! -f "$HOME/.config/sxhkd/sxhkdrc.common" ]] || configs+=("$HOME/.config/sxhkd/sxhkdrc.common")

awk '/^[a-z]/ && last {print "<small>",$0,"\t",last,"</small>"} {last=""} /^#/{last=$0}' "${configs[@]}" |
    column -t -s $'\t' |
    rofi -dmenu -i -markup-rows -no-show-icons -width 1000 -lines 15 -yoffset 40
