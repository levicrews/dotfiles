configuration {
    lines:                  10;
    columns:                2;
    font:                   "Cascadia Code PL 12";
    bw:                     0;
    location:               0;
    padding:                0;
    fixed-num-lines:        true;
    show-icons:             true;
    sidebar-mode:           true;
    separator-style:        "none";
    hide-scrollbar:         true;
    fullscreen:             false;
    fake-transparency:      false;
    scroll-method:          1;
    window-format:          "[{w}] ··· {c} ···   {t}";
    click-to-exit:          true;
    show-match:             false;
    combi-hide-mode-prefix: false;
    display-window:         "";
    display-windowcd:       "";
    display-run:            "";
    display-ssh:            "";
    display-drun:           "";
    display-combi:          "";
    display-filebrowser:    "";
    file-browser-dir:       "~/Dropbox/crewsbib/pdf";
}

@import "colors.rasi"

* {
    background-color: @background-light;
}

window {
    border:        0px;
    border-color:  @background;
    border-radius: 12px;
    padding:       40;
    width:         50%;
    height:        50%;
}

prompt {
    spacing:    0;
    border:     0;
    text-color: @foreground;
}

textbox-prompt-colon {
    expand:     false;
    str:        " ";
    margin:     0px 4px 0px 0px;
    text-color: inherit;
}

entry {
    spacing:    0;
    text-color: @foreground;
}

case-indicator {
    spacing:    0;
    text-color: @foreground;
}

inputbar {
    spacing:    0px;
    text-color: @foreground;
    padding:    1px;
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

mainbox {
    border:       0px;
    border-color: @background;
    padding:      6;
}

listview {
    fixed-height: 0;
    border:       0px;
    border-color: @background;
    spacing:      4px;
    scrollbar:    false;
    padding:      4px 0px 0px;
}


element {
    border:  0px;
    padding: 1px;
}
element normal.normal {
    background-color: @background-light;
    text-color:       @foreground;
}
element normal.urgent {
    background-color: @background-light;
    text-color:       @red;
}
element normal.active {
    background-color: @background-light;
    text-color:       @green;
}
element selected.normal {
    background-color: @background-light;
    text-color:       @selection;
}
element selected.urgent {
    background-color: @background-light;
    text-color:       @red;
}
element selected.active {
    background-color: @background-light;
    text-color:       @selection;
}
element alternate.normal {
    background-color: @background-light;
    text-color:       @foreground;
}
element alternate.urgent {
    background-color: @background-light;
    text-color:       @foreground;
}
element alternate.active {
    background-color: @background-light;
    text-color:       @foreground;
}

// https://github.com/davatorium/rofi/issues/1395#issuecomment-908625609
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element-icon {
    background-color: inherit;
}

sidebar {
    border:        0px;
    border-color:  @background;
    border-radius: 20px;
}

button {
    margin:        5px;
    padding:       5px;
    text-color:    @foreground;
    border:        0px;
    border-radius: 20px;
    border-color:  @foreground;
}

button selected {
    text-color:    @foreground;
    border:        3px;
    border-radius: 20px;
    border-color:  @selection;
}

scrollbar {
    width:        4px;
    border:       0px;
    handle-color: @foreground;
    handle-width: 8px;
    padding:      0;
}

message {
    border:       0px;
    border-color: @background;
    padding:      1px;
}

textbox {
    text-color: @foreground;
}
